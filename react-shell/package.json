    "typescript": "5.8.3",
    "vite": "6.4.6",
    "@playwright/test": "1.57.0"
  },
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2"
}
